# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# GitHub fine-grained PAT (Contents: Read and write, repo: Sovengar/obsidian-vault)
GITHUB_TOKEN=

# Cloudflare API token (from https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_TOKEN=

# Your Telegram user ID (from @userinfobot)
USER_ID=

# GitHub repo and branch
GITHUB_REPO=Sovengar/obsidian-vault
GITHUB_BRANCH=dev

# Cloudflare KV namespace ID (create with: npx wrangler kv namespace create LOGS)
KV_NAMESPACE_ID=